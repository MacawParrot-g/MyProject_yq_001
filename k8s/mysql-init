apiVersion: v1
kind: ConfigMap
metadata:
  name: mysql-init-sql
data:
  init.sql: |
    SET NAMES utf8mb4;
    SET FOREIGN_KEY_CHECKS = 0;
    CREATE TABLE IF NOT EXISTS `test_static` (
      `URL` varchar(255) NULL DEFAULT NULL,
      `bundleId` varchar(255) NULL DEFAULT NULL,
      `ascribe` varchar(255) NULL DEFAULT NULL,
      `event_number` int NULL DEFAULT NULL,
      `exception_type` varchar(255) NULL DEFAULT NULL,
      `record_data` varchar(20) NULL DEFAULT NULL,
      `recorder` varchar(255) NULL DEFAULT NULL,
      `remark` varchar(255) NULL DEFAULT NULL,
      `isOutput` tinyint NULL DEFAULT NULL,
      INDEX `idx_ascribe`(`ascribe` ASC) USING BTREE,
      INDEX `idx_recorder`(`recorder` ASC) USING BTREE,
      INDEX `idx_isOutput`(`isOutput` ASC) USING BTREE
    ) ENGINE = InnoDB CHARACTER SET = utf8mb4 COLLATE = utf8mb4_0900_ai_ci ROW_FORMAT = Dynamic;
    SET FOREIGN_KEY_CHECKS = 1;
